local aimbotKeyDown = false
local silentAimKeyDown = false

track(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    local aimKey = getKeyByName(Nova.Settings.Aimbot.Key)
    if input.KeyCode == aimKey or input.UserInputType == aimKey then
        aimbotKeyDown = true
        aimbotActive = true
    end

    local saKey = getKeyByName(Nova.Settings.SilentAim.Key)
    if input.KeyCode == saKey or input.UserInputType == saKey then
        silentAimKeyDown = true
        silentAimActive = true
    end

    if input.KeyCode == Nova.Settings.MenuKey then
        if Nova.UI then Nova.UI:Toggle() end
    end
    if input.KeyCode == Enum.KeyCode.F1 then
        Nova.Settings.ESP.Enabled = not Nova.Settings.ESP.Enabled
        notify("ESP: " .. tostring(Nova.Settings.ESP.Enabled))
    end
    if input.KeyCode == Enum.KeyCode.F2 then
        Nova.Settings.Aimbot.Enabled = not Nova.Settings.Aimbot.Enabled
        notify("Aimbot: " .. tostring(Nova.Settings.Aimbot.Enabled))
    end
    if input.KeyCode == Enum.KeyCode.F3 then
        Nova.Settings.SilentAim.Enabled = not Nova.Settings.SilentAim.Enabled
        notify("SilentAim: " .. tostring(Nova.Settings.SilentAim.Enabled))
    end
    if input.KeyCode == Enum.KeyCode.End then
        Nova.Unload()
    end
end))

track(UserInputService.InputEnded:Connect(function(input, gp)
    local aimKey = getKeyByName(Nova.Settings.Aimbot.Key)
    if input.KeyCode == aimKey or input.UserInputType == aimKey then
        aimbotKeyDown = false
        aimbotActive = false
    end

    local saKey = getKeyByName(Nova.Settings.SilentAim.Key)
    if input.KeyCode == saKey or input.UserInputType == saKey then
        silentAimKeyDown = false
        silentAimActive = false
    end
end))

