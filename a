local function track(conn)
    table.insert(Nova.Connections, conn)
    return conn
end

local function keep(inst)
    table.insert(Nova.Instances, inst)
    return inst
end

local function safe(key)
    local s = Nova.Settings
    for part in key:gmatch("[^%.]+") do
        s = s[part]
        if s == nil then return nil end
    end
    return s
end

-- Get key for aimbot from string
local function getKeyByName(name)
    if name == "MouseButton1" then return Enum.UserInputType.MouseButton1 end
    if name == "MouseButton2" then return Enum.UserInputType.MouseButton2 end
    if name == "MouseButton3" then return Enum.UserInputType.MouseButton3 end
    if name == "E" then return Enum.KeyCode.E end
    if name == "Q" then return Enum.KeyCode.Q end
    if name == "C" then return Enum.KeyCode.C end
    if name == "F" then return Enum.KeyCode.F end
    local ok, k = pcall(function() return Enum.KeyCode[name] end)
    if ok then return k end
    return Enum.UserInputType.MouseButton2
end

