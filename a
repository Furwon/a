local Game = {}

-- Get all "enemy" characters
function Game:GetFighters()
    local out = {}
    local myTeam = LP:GetAttribute("TeamID")
    local myEnv  = LP:GetAttribute("EnvironmentID")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        -- Environment check (Rivals separates matches by EnvironmentID)
        local plrEnv = plr:GetAttribute("EnvironmentID")
        if myEnv and plrEnv and plrEnv ~= myEnv then continue end

        -- Team check
        local plrTeam = plr:GetAttribute("TeamID")
        local isTeam = (myTeam ~= nil and plrTeam ~= nil and myTeam == plrTeam)

        if isTeam and Nova.Settings.Aimbot.IgnoreTeam then continue end
        if isTeam and not Nova.Settings.ESP.ShowTeam then continue end

        table.insert(out, {
            Player = plr,
            Character = char,
            Humanoid = hum,
            Root = root,
            Head = char:FindFirstChild("Head"),
            UpperTorso = char:FindFirstChild("UpperTorso"),
            LowerTorso = char:FindFirstChild("LowerTorso"),
            HitboxHead = char:FindFirstChild("HitboxHead"),
            HitboxBody = char:FindFirstChild("HitboxBody"),
            IsTeam = isTeam,
        })
    end
    return out
end

-- Check line of sight (whether part is visible from camera)
function Game:IsVisible(part, ignoreList)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local target = part.Position
    local dir = (target - origin)
    if dir.Magnitude < 1 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    if LP.Character then table.insert(filter, LP.Character) end
    if ignoreList then
        for _, v in ipairs(ignoreList) do table.insert(filter, v) end
    end
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local result = Workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

-- Get distance to part
local function distanceTo(part)
    if not part or not LP.Character then return math.huge end
    local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return math.huge end
    return (part.Position - myRoot.Position).Magnitude
end

