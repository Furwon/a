--  Silent Aim (hooks projectile remotes)
-- ═══════════════════════════════════════════════════════════════
local silentAimActive = false
local originalFireServer
local hookedRemote

-- Find the UseItem remote in Rivals
local function findUseItemRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    local repl = remotes:FindFirstChild("Replication")
    if not repl then return nil end
    local fighter = repl:FindFirstChild("Fighter")
    if not fighter then return nil end
    return fighter:FindFirstChild("UseItem")
end

local function getSilentAimTarget()
    if not LP.Character then return nil end
    local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, Nova.Settings.SilentAim.FOV

    for _, fighter in ipairs(Game:GetFighters()) do
        local part = fighter.Head
        if not part then continue end
        local dist = distanceTo(part)
        if dist > 1000 then continue end

        local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local screenVec = Vector2.new(screen.X, screen.Y)
        local screenDist = (screenVec - center).Magnitude
        if screenDist > Nova.Settings.SilentAim.FOV then continue end

        if Nova.Settings.SilentAim.WallCheck then
            if not Game:IsVisible(part, { fighter.Character }) then continue end
        end

        if screenDist < bestDist then
            bestDist = screenDist
            best = { part = part, fighter = fighter }
        end
    end
    return best
end

-- Simplified silent aim: hook remote fire, replace CFrame args
local function installSilentAim()
    if hookedRemote then return end
    local remote = findUseItemRemote()
    if not remote then
        warn("[Nova] UseItem remote not found - Silent Aim disabled")
        return
    end
    hookedRemote = remote

    -- Use hookmetamethod if available
    local hookFn = hookmetamethod or hookfunction
    if not hookFn then
        warn("[Nova] hookmetamethod/hookfunction not available - Silent Aim disabled")
        return
    end

    -- For simplicity, we use hookmetamethod on __namecall
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self == hookedRemote and Nova.Settings.SilentAim.Enabled and silentAimActive then
            if math.random() * 100 <= Nova.Settings.SilentAim.Chance then
                local target = getSilentAimTarget()
                if target then
                    local args = { ... }
                    -- args[1] = objectId
                    -- args[2] = encoded enum (StartShooting)
                    -- args[3] = payload table { ["\1"] = { ["\0"] = originCF, ["\1"] = dirCF, ["\2"] = hitbox } }
                    local payload = args[3]
                    if type(payload) == "table" then
                        local inner = payload["\1"]
                        if type(inner) == "table" then
                            local newCF = CFrame.new(Camera.CFrame.Position, target.part.Position)
                            inner["\0"] = newCF
                            inner["\1"] = newCF
                            inner["\2"] = target.part
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

-- ═══════════════════════════════════════════════════════════════
--  Triggerbot
-- ═══════════════════════════════════════════════════════════════
local lastTrigger = 0

local function updateTriggerbot()
    if not Nova.Settings.Triggerbot.Enabled then return end
    if not LP.Character then return end
    local hum = LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local now = tick()
    if now - lastTrigger < Nova.Settings.Triggerbot.Delay then return end

    -- Check if mouse is over an enemy
    local mouse = UserInputService:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(mouse.X, mouse.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)

    if not result then return end
    local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
    if not hitChar then return end
    local hitPlr = Players:GetPlayerFromCharacter(hitChar)
    if not hitPlr or hitPlr == LP then return end

    local myTeam = LP:GetAttribute("TeamID")
    local plrTeam = hitPlr:GetAttribute("TeamID")
    if myTeam and plrTeam and myTeam == plrTeam then return end

    -- Fire
    lastTrigger = now
    local vim = game:GetService("VirtualInputManager")
    if vim then
        vim:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
        task.wait(0.01)
        vim:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
    end
end

