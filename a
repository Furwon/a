-- Update ESP for one player (called every RenderStepped)
local function updatePlayerESP(plr)
    local objects = ESP.Drawing[plr]
    if not objects then return end
    if not Nova.Settings.ESP.Enabled then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        if objects.Health then objects.Health.Visible = false end
        if objects.Distance then objects.Distance.Visible = false end
        if objects.Tracer then objects.Tracer.Visible = false end
        if objects.HeadDot then objects.HeadDot.Visible = false end
        if objects.Billboard then objects.Billboard.Enabled = false end
        return
    end

    local char = plr.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hum or not root or not head then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        if objects.Health then objects.Health.Visible = false end
        if objects.Distance then objects.Distance.Visible = false end
        if objects.Tracer then objects.Tracer.Visible = false end
        if objects.HeadDot then objects.HeadDot.Visible = false end
        if objects.Billboard then objects.Billboard.Enabled = false end
        return
    end

    -- Team check
    local myTeam = LP:GetAttribute("TeamID")
    local plrTeam = plr:GetAttribute("TeamID")
    local isTeam = (myTeam ~= nil and plrTeam ~= nil and myTeam == plrTeam)
    if isTeam and not Nova.Settings.ESP.ShowTeam then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        if objects.Health then objects.Health.Visible = false end
        if objects.Distance then objects.Distance.Visible = false end
        if objects.Tracer then objects.Tracer.Visible = false end
        if objects.HeadDot then objects.HeadDot.Visible = false end
        return
    end

    -- Environment check
    local myEnv = LP:GetAttribute("EnvironmentID")
    local plrEnv = plr:GetAttribute("EnvironmentID")
    if myEnv and plrEnv and myEnv ~= plrEnv then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        return
    end

    -- Distance
    local dist = (root.Position - Camera.CFrame.Position).Magnitude
    if dist > Nova.Settings.ESP.MaxDistance then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        if objects.Health then objects.Health.Visible = false end
        if objects.Distance then objects.Distance.Visible = false end
        if objects.Tracer then objects.Tracer.Visible = false end
        if objects.HeadDot then objects.HeadDot.Visible = false end
        return
    end

    -- World-to-screen for head and feet
    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

    if not (headOnScreen and rootOnScreen) then
        if objects.Box then objects.Box.Visible = false end
        if objects.Name then objects.Name.Visible = false end
        if objects.Health then objects.Health.Visible = false end
        if objects.Distance then objects.Distance.Visible = false end
        if objects.Tracer then objects.Tracer.Visible = false end
        if objects.HeadDot then objects.HeadDot.Visible = false end
        return
    end

    local height = math.abs(rootPos.Y - headPos.Y)
    local width = height / 2
    local boxPos = Vector2.new(headPos.X - width / 2, headPos.Y)
    local boxSize = Vector2.new(width, height)

    -- Box
    if Drawing and objects.Box then
        objects.Box.Visible = Nova.Settings.ESP.Box
        objects.Box.Color = Nova.Settings.ESP.BoxColor
        objects.Box.Size = boxSize
        objects.Box.Position = boxPos
    end

    -- Name
    if Drawing and objects.Name then
        objects.Name.Visible = Nova.Settings.ESP.Name
        objects.Name.Text = plr.DisplayName or plr.Name
        objects.Name.Position = Vector2.new(boxPos.X + width / 2, boxPos.Y - 16)
        objects.Name.Size = TEXT_SIZE
    end

    -- Health
    if Drawing and objects.Health then
        objects.Health.Visible = Nova.Settings.ESP.Health and hum.Health > 0
        objects.Health.Text = string.format("%d HP", math.floor(hum.Health))
        objects.Health.Position = Vector2.new(boxPos.X + width / 2, boxPos.Y + height + 2)
    end

    -- Distance
    if Drawing and objects.Distance then
        objects.Distance.Visible = Nova.Settings.ESP.Distance
        objects.Distance.Text = string.format("[%d]", math.floor(dist))
        objects.Distance.Position = Vector2.new(boxPos.X + width / 2, boxPos.Y + height + 18)
    end

    -- Tracer (from bottom center of screen to box bottom)
    if Drawing and objects.Tracer then
        objects.Tracer.Visible = Nova.Settings.ESP.Tracer
        objects.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        objects.Tracer.To = Vector2.new(boxPos.X + width / 2, boxPos.Y + height)
        objects.Tracer.Color = Nova.Settings.ESP.TracerColor
    end

    -- Head dot
    if Drawing and objects.HeadDot then
        objects.HeadDot.Visible = Nova.Settings.ESP.HeadDot
        objects.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
    end

    -- Fallback billboard
    if not Drawing and objects.Billboard then
        objects.Billboard.Enabled = true
        objects.Billboard.Adornee = head
        local nameLabel = objects.Billboard:FindFirstChild("NameLabel")
        if nameLabel then nameLabel.Text = (Nova.Settings.ESP.Name and (plr.DisplayName or plr.Name)) or "" end
        local healthLabel = objects.Billboard:FindFirstChild("HealthLabel")
        if healthLabel then
            healthLabel.Text = Nova.Settings.ESP.Health and (string.format("%d HP", math.floor(hum.Health))) or ""
        end
    end

    -- Chams
    if Nova.Settings.ESP.Chams then
        applyChams(char)
    else
        removeChams(char)
    end
end

