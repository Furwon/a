--  Aimbot
-- ═══════════════════════════════════════════════════════════════
local aimbotActive = false
local currentTarget = nil

local function getFOVTarget()
    if not LP.Character then return nil end
    local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local mouse = UserInputService:GetMouseLocation()
    local camPos = Camera.ViewportSize
    local center = Vector2.new(camPos.X / 2, camPos.Y / 2)

    local bestTarget = nil
    local bestDist = Nova.Settings.Aimbot.FOV

    for _, fighter in ipairs(Game:GetFighters()) do
        local part = fighter.Head
        if Nova.Settings.Aimbot.TargetPart == "Body" then
            part = fighter.UpperTorso or fighter.LowerTorso or fighter.Root
        end
        if not part then continue end

        local dist = distanceTo(part)
        if dist > Nova.Settings.Aimbot.MaxDistance then continue end

        -- Screen position
        local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local screenVec = Vector2.new(screen.X, screen.Y)

        -- FOV check
        local screenDist = (screenVec - center).Magnitude
        if screenDist > Nova.Settings.Aimbot.FOV then continue end

        -- Wall check
        if Nova.Settings.Aimbot.WallCheck and Nova.Settings.Aimbot.VisibleOnly then
            if not Game:IsVisible(part, { fighter.Character }) then continue end
        end

        if screenDist < bestDist then
            bestDist = screenDist
            bestTarget = { fighter = fighter, part = part, position = part.Position, screen = screenVec }
        end
    end
    return bestTarget
end

local function updateAimbot()
    if not Nova.Settings.Aimbot.Enabled or not aimbotActive then
        currentTarget = nil
        return
    end

    local target = getFOVTarget()
    if not target then
        currentTarget = nil
        return
    end
    currentTarget = target

    -- Aim
    local targetPos = target.position
    local lookCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    local smooth = Nova.Settings.Aimbot.Smoothing

    if smooth <= 0 then
        Camera.CFrame = lookCFrame
    else
        Camera.CFrame = Camera.CFrame:Lerp(lookCFrame, math.clamp(1 - smooth, 0.05, 1))
    end
end

